<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsgp_bgk</name>
  <version>0.1.0</version>
  <description>
    FSGP-BGK traversability analysis -- Python algorithm package.
    Provides the core SGP-based traversability analyser and a thin
    ROS 2 service wrapper (traversability_service) that exposes it
    to the C++ infrastructure node.
  </description>
  <maintainer email="senmingtan5@gmail.com">Senming Tan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>fsgp_bgk_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
